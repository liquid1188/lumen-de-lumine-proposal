---
pageKey: events
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ lang | purl('events') }}"
---
{%- set t = i18n[lang.code] -%}
{%- set ph = { kicker: t.events.label, title: t.events.title, lede: t.events.lede } -%}
{% include "page-hero.njk" %}

<section class="section">
  <div class="wrap">
    {% include "events-list.njk" %}
    <p class="pending center">{{ t.events.more }}</p>
  </div>
</section>

<section class="cta-band">
  <div class="wrap narrow reveal">
    <h2>{{ t.cta.title }}</h2>
    <p>{{ t.cta.text }}</p>
    <p><a class="btn btn-gold" href="{{ lang | purl('support') | url }}">{{ t.cta.button }}</a></p>
  </div>
</section>
